rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // الإدارة فقط يمكنها قراءة قائمة المسؤولين (وإضافتهم من وحدة تحكم Firebase)
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /clients/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();

      // التقارير والزيارات: العميل يقرأ فقط ما يخصه، ولا يكتب أبدًا
      match /reports/{id} { allow read: if isOwner(uid) || isAdmin(); allow write: if isAdmin(); }
      match /visits/{id}  { allow read: if isOwner(uid) || isAdmin(); allow write: if isAdmin(); }

      // الإشعارات: العميل يستطيع فقط تغيير read إلى true
      match /notes/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() ||
          (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true);
      }

      // رموز الإشعارات الخاصة بجهاز العميل
      match /tokens/{token} {
        allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['token','ts']);
        allow read, delete: if isOwner(uid) || isAdmin();
      }
    }
  }
}
